[Unit]
Description=NVFD - NVIDIA Fan Daemon
After=multi-user.target nvidia-persistenced.service
Wants=nvidia-persistenced.service
# The daemon exits non-zero on any error and is restarted below. Five failed
# starts within a minute means a restart will not fix it: stop retrying and
# leave the unit failed where monitoring can see it.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
ExecStart=/usr/local/bin/nvfd
ExecReload=/bin/kill -HUP $MAINPID
# The daemon pings the watchdog after every 5s poll, so a hung NVML call or a
# stuck loop is killed and restarted. WatchdogSignal= makes that kill land on
# the daemon's own clean-shutdown path; the default SIGABRT would not.
WatchdogSec=30
WatchdogSignal=SIGTERM
Restart=on-failure
RestartSec=5

# Runs however the daemon exited, including the kills it cannot catch (SIGKILL,
# the OOM killer, a segfault) and after the start limit gives up. Without it a
# GPU stays in NVML manual policy at whatever speed was last written, with no
# temperature feedback, until the next reboot. Fans only: it does not touch the
# saved per-GPU modes in /etc/nvfd, which `nvfd auto` would rewrite.
ExecStopPost=-/usr/local/bin/nvfd reset-fans

# Security hardening
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/nvfd
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
ProtectHostname=yes
# No ProtectClock=: it implies DeviceAllow=char-rtc, and any DeviceAllow= turns
# on DevicePolicy=closed, which hides /dev/nvidiactl and /dev/nvidia* from the
# daemon. NVML then fails to initialise with "Unknown Error".

[Install]
WantedBy=multi-user.target
