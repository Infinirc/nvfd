[Unit]
Description=NVFD - NVIDIA Fan Daemon
After=multi-user.target nvidia-persistenced.service
Wants=nvidia-persistenced.service
# The daemon exits non-zero on any error and is restarted below. Five failed
# starts within a minute means a restart will not fix it: stop retrying and
# leave the unit failed where monitoring can see it.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
ExecStart=/usr/local/bin/nvfd
# The daemon pings the watchdog after every 5s poll. A hung NVML call or a
# stuck loop is killed and restarted instead of leaving the fans pinned at
# whatever speed was last set.
WatchdogSec=30
Restart=on-failure
RestartSec=5

# Security hardening
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/nvfd
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
ProtectHostname=yes

[Install]
WantedBy=multi-user.target
