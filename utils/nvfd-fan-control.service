[Unit]
Description=NVIDIA Fan Control - Temperature-aware per-GPU mode switching
StartLimitIntervalSec=400
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/local/bin/nvfd-fan-control.sh --threshold-up 45 --threshold-down 35
Restart=on-failure
RestartSec=90
User=root

[Install]
WantedBy=multi-user.target
